---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, getBlogPosts } from '@/lib/content';

const posts = await getBlogPosts();
const groups = Map.groupBy(posts, (post) => post.data.publishedAt.getFullYear());
const years = [...groups.keys()].sort((a, b) => b - a);
---

<BaseLayout title="归档" description="按时间浏览所有文章。">
	<section class="page-section shell archive-page">
		<header class="page-header">
			<p class="eyebrow">Archive</p>
			<h1>归档</h1>
			<p>{posts.length} 篇文章，按发布时间排列。</p>
		</header>
		<div class="archive-groups">
			{
				years.map((year) => (
					<section>
						<>
							<h2>{year}</h2>
							<ol>
								{groups.get(year)?.map((post) => (
									<li>
										<time datetime={post.data.publishedAt.toISOString()}>
											{formatDate(post.data.publishedAt).slice(5)}
										</time>
										<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									</li>
								))}
							</ol>
						</>
					</section>
				))
			}
		</div>
	</section>
</BaseLayout>
