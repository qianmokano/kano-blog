---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/global.css';
import '@/styles/ambient-motion.css';
import '@/styles/kinetic-motion.css';
import BaseHead from '@/components/BaseHead.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import SearchDialog from '@/components/SearchDialog.astro';
import { siteConfig } from '@/lib/site';
import { authorSchema } from '@/lib/structured-data';
import type { SocialImage } from '@/lib/social-image';

interface Props {
	title?: string;
	description?: string;
	image?: string | SocialImage;
	type?: 'website' | 'article';
	noindex?: boolean;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
	mainClass?: string;
}

const { mainClass = '', ...headProps } = Astro.props;
const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: siteConfig.name,
	url: siteConfig.url,
	description: siteConfig.description,
	inLanguage: siteConfig.locale,
	author: authorSchema,
};
---

<!doctype html>
<html lang={siteConfig.locale}>
	<head>
		<BaseHead {...headProps} structuredData={headProps.structuredData ?? websiteSchema} />
		<script is:inline>
			// Keep history traversal immediate so the browser can restore the reading position.
			window.addEventListener('pageswap', (event) => {
				if (event.activation?.navigationType === 'traverse') {
					event.viewTransition?.skipTransition();
				}
			});
			window.addEventListener('pagereveal', (event) => {
				if (window.navigation?.activation?.navigationType === 'traverse') {
					event.viewTransition?.skipTransition();
				}
			});
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">跳到正文</a>
		<Header />
		<main id="main-content" class={mainClass} tabindex="-1">
			<slot />
		</main>
		<Footer />
		<SearchDialog />

		<script is:inline src="/scripts/search.js"></script>
		<script>
			import '@/scripts/motion-system';
			import '@/scripts/ambient-motion';
			import '@/scripts/list-feedback';
			import '@/scripts/theme-motion';
			import '@/scripts/kinetic-type';
			import '@/scripts/magnetic-effect';
			import '@/scripts/focus-ring';
		</script>
	</body>
</html>
