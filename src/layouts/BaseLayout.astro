---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/global.css';
import BaseHead from '@/components/BaseHead.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import SearchDialog from '@/components/SearchDialog.astro';
import { siteConfig } from '@/lib/site';
import { authorSchema } from '@/lib/structured-data';
import type { SocialImage } from '@/lib/social-image';

interface Props {
	title?: string;
	description?: string;
	image?: string | SocialImage;
	type?: 'website' | 'article';
	noindex?: boolean;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
	mainClass?: string;
}

const { mainClass = '', ...headProps } = Astro.props;
const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: siteConfig.name,
	url: siteConfig.url,
	description: siteConfig.description,
	inLanguage: siteConfig.locale,
	author: authorSchema,
};
---

<!doctype html>
<html lang={siteConfig.locale}>
	<head>
		<BaseHead {...headProps} structuredData={headProps.structuredData ?? websiteSchema} />
		<script is:inline>
			// Keep history traversal immediate so the browser can restore the reading position.
			window.addEventListener('pageswap', (event) => {
				if (event.activation?.navigationType === 'traverse') {
					event.viewTransition?.skipTransition();
				}
			});
			window.addEventListener('pagereveal', (event) => {
				if (window.navigation?.activation?.navigationType === 'traverse') {
					event.viewTransition?.skipTransition();
				}
			});
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">跳到正文</a>
		<Header />
		<main id="main-content" class={mainClass} tabindex="-1">
			<slot />
		</main>
		<Footer />
		<SearchDialog />
		<script is:inline>
			(() => {
				const root = document.documentElement;
				const themes = ['system', 'dark', 'light'];
				const labels = {
					system: '当前跟随系统，点击切换为深色',
					dark: '当前为深色，点击切换为浅色',
					light: '当前为浅色，点击切换为跟随系统',
				};
				const applyTheme = (theme) => {
					root.dataset.theme = theme;
					root.style.colorScheme = theme === 'system' ? 'light dark' : theme;
					try {
						if (theme === 'system') localStorage.removeItem('theme');
						else localStorage.setItem('theme', theme);
					} catch {}
					document
						.querySelectorAll('[data-theme-toggle]')
						.forEach((button) => button.setAttribute('aria-label', labels[theme]));
				};
				document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
					button.addEventListener('click', () => {
						const current = root.dataset.theme || 'system';
						applyTheme(themes[(themes.indexOf(current) + 1) % themes.length]);
					});
				});
				applyTheme(root.dataset.theme || 'system');

				const dialog = document.querySelector('[data-search-dialog]');
				const input = dialog?.querySelector('[data-pagefind-input]');
				let searchOpener;
				const openSearch = () => {
					if (dialog instanceof HTMLDialogElement && !dialog.open) {
						searchOpener = document.activeElement;
						dialog.showModal();
						requestAnimationFrame(() => input?.focus());
					}
				};
				const closeSearch = () => {
					if (dialog instanceof HTMLDialogElement) dialog.close();
				};
				dialog?.addEventListener('close', () => {
					requestAnimationFrame(() => {
						if (!dialog.open && searchOpener instanceof HTMLElement) searchOpener.focus();
					});
				});
				dialog?.addEventListener('keydown', (event) => {
					// Search inputs can consume Escape to clear their value before the dialog closes.
					if (event.key === 'Escape' && !event.isComposing) {
						event.preventDefault();
						closeSearch();
					}
				});
				document
					.querySelectorAll('[data-search-open]')
					.forEach((button) => button.addEventListener('click', openSearch));
				dialog?.querySelector('[data-search-close]')?.addEventListener('click', closeSearch);
				dialog?.addEventListener('click', (event) => {
					if (event.target === dialog) closeSearch();
				});
				document.addEventListener('keydown', (event) => {
					if (
						(event.key === '/' && !/input|textarea/i.test(document.activeElement?.tagName || '')) ||
						((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k')
					) {
						event.preventDefault();
						openSearch();
					}
				});
			})();
		</script>
		<script is:inline src="/scripts/search.js"></script>
	</body>
</html>
