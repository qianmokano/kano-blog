---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Giscus from '@/components/Giscus.astro';
import TocLinks from '@/components/TocLinks.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, getReadingTime, normalizeTagSlug } from '@/lib/content';
import { siteConfig } from '@/lib/site';
import { absoluteSiteUrl, authorSchema, createBreadcrumbSchema } from '@/lib/structured-data';
import { getSocialImage } from '@/lib/social-image';

interface Props {
	post: CollectionEntry<'blog'>;
	headings: { depth: number; slug: string; text: string }[];
	previous?: CollectionEntry<'blog'>;
	next?: CollectionEntry<'blog'>;
	related?: CollectionEntry<'blog'>[];
}

const { post, headings, previous, next, related = [] } = Astro.props;
const articlePath = `/blog/${post.id}/`;
const socialImage = await getSocialImage(post);
const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.publishedAt.toISOString(),
	dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
	inLanguage: siteConfig.locale,
	mainEntityOfPage: absoluteSiteUrl(articlePath),
	author: authorSchema,
	image: absoluteSiteUrl(socialImage.src),
};
const breadcrumbSchema = createBreadcrumbSchema([
	{ name: '首页', path: '/' },
	{ name: '文章', path: '/blog/' },
	{ name: post.data.title, path: articlePath },
]);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	type="article"
	image={socialImage}
	structuredData={[articleSchema, breadcrumbSchema]}
>
	<article class="article-page" data-pagefind-body data-pagefind-meta="type:文章">
		<header class="article-header reading-shell">
			<div class="content-meta">
				<time datetime={post.data.publishedAt.toISOString()}
					>{formatDate(post.data.publishedAt)}</time
				>
				<span>{getReadingTime(post.body ?? '')} 分钟阅读</span>
				{post.data.updatedAt && <span>更新于 {formatDate(post.data.updatedAt)}</span>}
			</div>
			<h1 data-pagefind-meta="title">{post.data.title}</h1>
			<p>{post.data.description}</p>
			<ul class="tag-list" aria-label="标签">
				{
					post.data.tags.map((tag) => (
						<li>
							<a href={`/tags/${normalizeTagSlug(tag)}/`}>{tag}</a>
						</li>
					))
				}
			</ul>
		</header>
		{
			post.data.cover && (
				<figure class="content-cover reading-shell">
					<Image
						src={post.data.cover}
						alt={post.data.coverAlt ?? `${post.data.title}的封面`}
						widths={[480, 768, 1200]}
						sizes="(max-width: 48rem) calc(100vw - 1.5rem), 48rem"
					/>
				</figure>
			)
		}

		<div class:list={['article-grid shell', { 'without-toc': toc.length === 0 }]}>
			{
				toc.length > 0 && (
					<details class="mobile-toc" data-pagefind-ignore>
						<summary>
							<span>目录 · {toc.length} 节</span>
							<span class="toc-current" data-toc-current>
								{toc[0].text}
							</span>
						</summary>
						<TocLinks headings={toc} />
					</details>
				)
			}
			<div class="prose"><slot /></div>
			{
				toc.length > 0 && (
					<aside class="article-toc" data-pagefind-ignore>
						<p class="eyebrow">On this page</p>
						<TocLinks headings={toc} />
					</aside>
				)
			}
		</div>

		<nav class="article-neighbors reading-shell" aria-label="相邻文章" data-pagefind-ignore>
			{
				previous ? (
					<a href={`/blog/${previous.id}/`}>
						<>
							<span>← 上一篇</span>
							<strong>{previous.data.title}</strong>
						</>
					</a>
				) : (
					<span />
				)
			}
			{
				next ? (
					<a class="next" href={`/blog/${next.id}/`}>
						<>
							<span>下一篇 →</span>
							<strong>{next.data.title}</strong>
						</>
					</a>
				) : (
					<span />
				)
			}
		</nav>
		{
			related.length > 0 && (
				<section class="related-posts reading-shell" data-pagefind-ignore>
					<p class="eyebrow">Keep reading</p>
					<h2>相关文章</h2>
					<ul>
						{related.map((item) => (
							<li>
								<a href={`/blog/${item.id}/`}>
									{item.data.title}
									<span aria-hidden="true">↗</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}
		{
			post.data.comments && (
				<div class="reading-shell">
					<Giscus />
				</div>
			)
		}
	</article>
</BaseLayout>

<script>
	document.querySelectorAll<HTMLElement>('.prose pre').forEach((block) => {
		if (block.querySelector('.copy-code')) return;
		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'copy-code';
		button.textContent = '复制';
		button.setAttribute('aria-label', '复制代码');
		button.addEventListener('click', async () => {
			const code = block.querySelector('code')?.textContent ?? '';
			try {
				await navigator.clipboard.writeText(code);
				button.textContent = '已复制';
			} catch {
				button.textContent = '复制失败';
			}
			setTimeout(() => (button.textContent = '复制'), 1600);
		});
		block.append(button);
	});

	const toc = document.querySelector<HTMLElement>('.article-toc');
	const mobileToc = document.querySelector<HTMLDetailsElement>('.mobile-toc');
	const mobileLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.mobile-toc a'));
	const currentSection = document.querySelector<HTMLElement>('[data-toc-current]');
	mobileLinks.forEach((link) => {
		link.addEventListener('click', () => {
			if (mobileToc) mobileToc.open = false;
			const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
			if (heading) {
				heading.tabIndex = -1;
				heading.focus({ preventScroll: true });
			}
		});
	});
	mobileToc?.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && mobileToc.open) {
			mobileToc.open = false;
			mobileToc.querySelector('summary')?.focus();
		}
	});
	const prose = document.querySelector<HTMLElement>('.article-grid > .prose');
	const tocItems = Array.from(
		document.querySelectorAll<HTMLAnchorElement>('.article-toc a[href^="#"]'),
	).flatMap((link) => {
		const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
		return heading ? [{ heading, link }] : [];
	});

	if (toc && prose && tocItems.length > 0) {
		let animationFrame = 0;

		const updateReadingProgress = () => {
			animationFrame = 0;
			const readingLine = window.innerHeight * 0.25;
			let activeItem = tocItems[0];

			for (const item of tocItems) {
				if (item.heading.getBoundingClientRect().top > readingLine) break;
				activeItem = item;
			}

			for (const item of tocItems) {
				if (item === activeItem) item.link.setAttribute('aria-current', 'location');
				else item.link.removeAttribute('aria-current');
			}
			mobileLinks.forEach((link) => {
				if (link.hash === activeItem.link.hash) link.setAttribute('aria-current', 'location');
				else link.removeAttribute('aria-current');
			});
			if (currentSection) currentSection.textContent = activeItem.link.textContent;

			const proseTop = prose.getBoundingClientRect().top + window.scrollY;
			const progressStart = proseTop - readingLine;
			const progressDistance = Math.max(prose.offsetHeight - window.innerHeight * 0.5, 1);
			const progress = Math.min(
				Math.max((window.scrollY - progressStart) / progressDistance, 0),
				1,
			);
			toc.style.setProperty('--toc-progress', String(progress));
		};

		const requestProgressUpdate = () => {
			if (animationFrame) return;
			animationFrame = window.requestAnimationFrame(updateReadingProgress);
		};

		window.addEventListener('scroll', requestProgressUpdate, { passive: true });
		window.addEventListener('resize', requestProgressUpdate);
		updateReadingProgress();
	}
</script>
