---
interface Props {
	currentPage: number;
	totalPages: number;
	basePath: string;
}

const { currentPage, totalPages, basePath } = Astro.props;
const hrefFor = (page: number) => (page === 1 ? `${basePath}/` : `${basePath}/page/${page}/`);
---

{
	totalPages > 1 && (
		<nav class="pagination" aria-label="分页">
			{currentPage > 1 ? <a href={hrefFor(currentPage - 1)}>← 上一页</a> : <span />}
			<span>
				{currentPage} / {totalPages}
			</span>
			{currentPage < totalPages ? <a href={hrefFor(currentPage + 1)}>下一页 →</a> : <span />}
		</nav>
	)
}
