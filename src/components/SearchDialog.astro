---
import SearchResults from '@/components/SearchResults.astro';
---

<dialog class="search-dialog" data-search-dialog aria-labelledby="search-dialog-title">
	<div class="search-dialog-panel">
		<div class="search-dialog-header">
			<h2 id="search-dialog-title">搜索</h2>
			<button class="icon-button" type="button" data-search-close aria-label="关闭搜索">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
			</button>
		</div>
		<label class="search-field">
			<span class="sr-only">搜索文章、笔记和项目</span>
			<svg viewBox="0 0 24 24" aria-hidden="true"
				><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg
			>
			<input type="search" data-pagefind-input placeholder="输入关键词…" autocomplete="off" />
			<kbd>ESC</kbd>
		</label>
		<SearchResults />
		<a class="search-all-link" href="/search/" data-search-all
			>前往完整搜索页 <span aria-hidden="true">↗</span></a
		>
	</div>
</dialog>
