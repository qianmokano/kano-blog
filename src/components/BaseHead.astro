---
import { siteConfig } from '@/lib/site';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	noindex?: boolean;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title,
	description = siteConfig.description,
	image = '/og-default.svg',
	type = 'website',
	noindex = false,
	structuredData,
} = Astro.props;
const pageTitle = title ? `${title} - ${siteConfig.brandName}` : siteConfig.title;
const canonical = new URL(Astro.url.pathname, siteConfig.url);
const socialImage = new URL(image, siteConfig.url);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={type} />
<meta property="og:locale" content={siteConfig.locale.replace('-', '_')} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<script is:inline>
	(() => {
		try {
			const saved = localStorage.getItem('theme');
			const theme = saved === 'light' || saved === 'dark' ? saved : 'system';
			document.documentElement.dataset.theme = theme;
			document.documentElement.style.colorScheme = theme === 'system' ? 'light dark' : theme;
		} catch {
			document.documentElement.dataset.theme = 'system';
		}
	})();
</script>
{
	structuredData && (
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	)
}
