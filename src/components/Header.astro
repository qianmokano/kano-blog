---
import { siteConfig } from '@/lib/site';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
	<div class="shell header-inner">
		<a class="wordmark" href="/" aria-label={`${siteConfig.brandName} 首页`}>
			<span class="wordmark-text">{siteConfig.brandName}</span>
		</a>

		<nav class="desktop-nav" aria-label="主导航">
			{
				siteConfig.navigation.map((item) => (
					<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="header-actions">
			<button
				class="icon-button search-trigger"
				type="button"
				data-search-open
				aria-label="打开搜索"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true"
					><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg
				>
			</button>
			<button
				class="icon-button theme-toggle"
				type="button"
				data-theme-toggle
				aria-label="切换主题"
			>
				<svg class="theme-icon theme-icon-system" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="9"></circle>
					<path class="theme-icon-system-fill" d="M12 3a9 9 0 0 1 0 18Z"></path>
				</svg>
				<svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="3.5"></circle>
					<path
						d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
					></path>
				</svg>
				<svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"></path>
				</svg>
			</button>
			<details class="mobile-menu" data-mobile-menu>
				<summary class="icon-button" aria-label="打开导航">
					<svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true">
						<path class="menu-icon-line menu-icon-line-top" d="M4 7h16"></path>
						<path class="menu-icon-line menu-icon-line-middle" d="M4 12h16"></path>
						<path class="menu-icon-line menu-icon-line-bottom" d="M4 17h16"></path>
					</svg>
				</summary>
				<nav aria-label="移动导航">
					{
						siteConfig.navigation.map((item) => (
							<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						))
					}
					<a href="/search/">搜索</a>
				</nav>
			</details>
		</div>
	</div>
</header>

<style>
	.mobile-menu {
		--menu-icon-duration: 120ms;
	}

	.mobile-menu[open] {
		--menu-icon-duration: 180ms;
	}

	.menu-icon-line {
		transform-box: view-box;
		transform-origin: 12px 12px;
		transition:
			transform var(--menu-icon-duration) var(--ease),
			opacity var(--menu-icon-duration) ease;
	}

	.mobile-menu[open] .menu-icon-line-top {
		transform: rotate(45deg) translateY(5px);
	}

	.mobile-menu[open] .menu-icon-line-middle {
		opacity: 0;
	}

	.mobile-menu[open] .menu-icon-line-bottom {
		transform: rotate(-45deg) translateY(-5px);
	}

	@media (prefers-reduced-motion: reduce) {
		.menu-icon-line {
			transition: none !important;
		}
	}
</style>

<script>
	const setupMobileMenu = () => {
		document.querySelectorAll<HTMLDetailsElement>('[data-mobile-menu]').forEach((menu) => {
			const summary = menu.querySelector<HTMLElement>('summary');
			const setLabel = () =>
				summary?.setAttribute('aria-label', menu.open ? '关闭导航' : '打开导航');
			const close = (returnFocus = false) => {
				if (!menu.open) return;
				menu.open = false;
				setLabel();
				if (returnFocus) summary?.focus();
			};

			setLabel();
			menu.addEventListener('toggle', setLabel);
			menu.addEventListener('keydown', (event) => {
				if (event.key !== 'Escape' || event.isComposing || !menu.open) return;
				event.preventDefault();
				close(true);
			});
			menu.querySelector('nav')?.addEventListener('click', (event) => {
				if (event.target instanceof Element && event.target.closest('a')) close();
			});
			document.addEventListener('click', (event) => {
				if (menu.open && !menu.contains(event.target as Node)) close();
			});
		});
	};

	setupMobileMenu();
</script>
