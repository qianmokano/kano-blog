---
import { siteConfig } from '@/lib/site';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
	<div class="shell header-inner">
		<a class="wordmark" href="/" aria-label={`${siteConfig.name} 首页`}>
			<span aria-hidden="true">K</span>
			<span class="wordmark-text">{siteConfig.name}</span>
		</a>

		<nav class="desktop-nav" aria-label="主导航">
			{
				siteConfig.navigation.map((item) => (
					<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="header-actions">
			<button
				class="icon-button search-trigger"
				type="button"
				data-search-open
				aria-label="打开搜索"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true"
					><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg
				>
			</button>
			<button
				class="icon-button theme-toggle"
				type="button"
				data-theme-toggle
				aria-label="切换主题"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true"
					><path d="M12 3v18M12 3a9 9 0 0 1 0 18A9 9 0 0 1 12 3Z"></path></svg
				>
			</button>
			<details class="mobile-menu">
				<summary class="icon-button" aria-label="打开导航">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg
					>
				</summary>
				<nav aria-label="移动导航">
					{
						siteConfig.navigation.map((item) => (
							<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						))
					}
					<a href="/search/">搜索</a>
				</nav>
			</details>
		</div>
	</div>
</header>
