---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate } from '@/lib/content';

interface Props {
	entryId: 'about' | 'uses' | 'now';
}

const { entryId } = Astro.props;
const entry = await getEntry('pages', entryId);
if (!entry) throw new Error(`缺少页面内容：${entryId}`);
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<article
		class="page-section reading-shell prose-page"
		data-pagefind-body
		data-pagefind-meta={`type:页面`}
	>
		<header class="prose-header">
			<p class="eyebrow">Page</p>
			<h1 data-pagefind-meta="title">{entry.data.title}</h1>
			<p>{entry.data.description}</p>
			{
				entry.data.updatedAt && (
					<time datetime={entry.data.updatedAt.toISOString()}>
						更新于 {formatDate(entry.data.updatedAt)}
					</time>
				)
			}
		</header>
		<div class="prose"><Content /></div>
	</article>
</BaseLayout>
