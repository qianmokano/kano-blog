---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/lib/content';

interface Props {
	note: CollectionEntry<'notes'>;
	headingLevel?: 'h2' | 'h3';
}

const { note, headingLevel: Heading = 'h2' } = Astro.props;
---

<li class="content-card note-card" data-pagefind-ignore>
	<div class="content-meta note-date">
		<time datetime={note.data.publishedAt.toISOString()}>{formatDate(note.data.publishedAt)}</time>
		{note.data.draft && <span>草稿</span>}
	</div>
	<div>
		<Heading>
			<a href={`/notes/${note.id}/`} data-transition-title-link
				><span data-transition-title-source>{note.data.title}</span></a
			>
		</Heading>
		{note.data.tags.length > 0 && <p>{note.data.tags.join(' · ')}</p>}
	</div>
	<span class="content-arrow" aria-hidden="true">↗</span>
</li>
