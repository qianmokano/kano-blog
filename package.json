{
	"name": "kano-blog",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@10.10.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --background",
		"dev:stop": "ASTRO_TELEMETRY_DISABLED=1 astro dev stop",
		"dev:status": "ASTRO_TELEMETRY_DISABLED=1 astro dev status",
		"dev:logs": "ASTRO_TELEMETRY_DISABLED=1 astro dev logs",
		"build": "pnpm check && ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist",
		"preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
		"check": "ASTRO_TELEMETRY_DISABLED=1 astro check && eslint . && prettier --check .",
		"check:types": "ASTRO_TELEMETRY_DISABLED=1 astro check",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:full": "pnpm build && playwright test",
		"astro": "ASTRO_TELEMETRY_DISABLED=1 astro"
	},
	"dependencies": {
		"@astrojs/mdx": "^7.0.8",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@resvg/resvg-js": "^2.6.2",
		"astro": "^7.2.9",
		"reading-time": "^1.5.0",
		"sharp": "^0.35.4"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.62.1",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.9.1",
		"eslint-plugin-astro": "^3.1.0",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vitest": "^4.1.11"
	}
}
